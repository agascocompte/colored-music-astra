    "preview:lan": "vite preview --host 0.0.0.0 --port 4174 --strictPort"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.1"
  }
